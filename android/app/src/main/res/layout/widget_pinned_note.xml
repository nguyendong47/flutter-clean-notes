<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pinned_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_card"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_pinned_active_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_pin"
                android:contentDescription="@string/widget_pinned" />

            <TextView
                android:id="@+id/widget_pinned_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tiêu đề ghi chú"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_pinned_action_edit"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_edit"
                android:contentDescription="@string/widget_new_note" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#20FFFFFF" />

        <!-- Plain note preview (when no checklist items) -->
        <TextView
            android:id="@+id/widget_pinned_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="6"
            android:text="Nội dung ghi chú..."
            android:textColor="#D0FFFFFF"
            android:textSize="13sp" />

        <!-- Interactive checklist container -->
        <LinearLayout
            android:id="@+id/widget_pinned_checklist_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Item Row 0 -->
            <LinearLayout
                android:id="@+id/widget_item_row_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_item_check_0"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_checkbox_unchecked"
                    android:contentDescription="Check item 0" />
                <TextView
                    android:id="@+id/widget_item_text_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Item Row 1 -->
            <LinearLayout
                android:id="@+id/widget_item_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_item_check_1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_checkbox_unchecked"
                    android:contentDescription="Check item 1" />
                <TextView
                    android:id="@+id/widget_item_text_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Item Row 2 -->
            <LinearLayout
                android:id="@+id/widget_item_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_item_check_2"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_checkbox_unchecked"
                    android:contentDescription="Check item 2" />
                <TextView
                    android:id="@+id/widget_item_text_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Item Row 3 -->
            <LinearLayout
                android:id="@+id/widget_item_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_item_check_3"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_checkbox_unchecked"
                    android:contentDescription="Check item 3" />
                <TextView
                    android:id="@+id/widget_item_text_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Item Row 4 -->
            <LinearLayout
                android:id="@+id/widget_item_row_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_item_check_4"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_checkbox_unchecked"
                    android:contentDescription="Check item 4" />
                <TextView
                    android:id="@+id/widget_item_text_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Item Row 5 -->
            <LinearLayout
                android:id="@+id/widget_item_row_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_item_check_5"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_checkbox_unchecked"
                    android:contentDescription="Check item 5" />
                <TextView
                    android:id="@+id/widget_item_text_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Item Row 6 -->
            <LinearLayout
                android:id="@+id/widget_item_row_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_item_check_6"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_checkbox_unchecked"
                    android:contentDescription="Check item 6" />
                <TextView
                    android:id="@+id/widget_item_text_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Item Row 7 -->
            <LinearLayout
                android:id="@+id/widget_item_row_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_item_check_7"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_checkbox_unchecked"
                    android:contentDescription="Check item 7" />
                <TextView
                    android:id="@+id/widget_item_text_7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#E0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- More items text -->
            <TextView
                android:id="@+id/widget_item_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="2dp"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_pinned_empty_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_widget_pin"
            android:alpha="0.5"
            android:contentDescription="@string/widget_pinned" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_no_pinned"
            android:textColor="#E0FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/widget_no_pinned_hint"
            android:textColor="#90FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_btn_empty_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_glass_pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_new_note"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
