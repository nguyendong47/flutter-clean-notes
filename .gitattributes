# Normalize all text files to LF regardless of the checkout platform,
# so copying the working tree between Windows/macOS doesn't reintroduce
# CRLF noise across the whole diff (see 2026-09-21 CRLF cleanup).
* text=auto eol=lf

android/gradlew text eol=lf
android/gradlew.bat text eol=crlf
android/gradle/wrapper/gradle-wrapper.properties text eol=lf
